{
  "name": "@karashiiro/my-cool-proxy",
  "version": "1.6.1",
  "description": "Use as many MCP servers as you want while minimizing context usage. A code mode MCP server gateway driven with Lua 🌙",
  "main": "dist/index.js",
  "mcpName": "io.github.karashiiro/my-cool-proxy",
  "bin": {
    "my-cool-proxy": "./bin/my-cool-proxy.mjs"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup && tsgo -p tsconfig.test-build.json",
    "build:bundle": "tsup",
    "build:tests": "tsgo -p tsconfig.test-build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsgo --noEmit"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "proxy",
    "gateway",
    "lua",
    "typescript"
  ],
  "author": "karashiiro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/karashiiro/my-cool-proxy.git"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "@my-cool-proxy/acp-client": "workspace:*",
    "@my-cool-proxy/dashboard-ui": "workspace:*",
    "@my-cool-proxy/logger": "workspace:*",
    "@my-cool-proxy/lua-runtime": "workspace:*",
    "@my-cool-proxy/mcp-aggregation": "workspace:*",
    "@my-cool-proxy/mcp-client": "workspace:*",
    "@my-cool-proxy/mcp-sampling-sidecar": "workspace:*",
    "@my-cool-proxy/mcp-utilities": "workspace:*",
    "@suites/di.inversify": "4.0.0-alpha.0",
    "@suites/doubles.vitest": "4.0.0-beta.0",
    "@suites/unit": "4.0.0-beta.0",
    "@swc/core": "^1.15.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.5.0",
    "@typescript/native-preview": "7.0.0-dev.20251217.1",
    "jiti": "^2.6.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@inversifyjs/strongly-typed": "^2.2.0",
    "@karashiiro/mcp": "0.7.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "better-sqlite3": "^11.10.0",
    "env-paths": "^3.0.0",
    "hono": "^4.11.4",
    "inversify": "^7.10.7",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "wasmoon": "^1.16.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  }
}
